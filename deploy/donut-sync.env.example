# Donut Sync 自托管：环境变量模板
#
#   cp donut-sync.env.example .env      # compose 会用同目录的 .env 做变量插值
#   docker compose -f docker-compose.sync.yml up -d
#
# 变量名逐个对应 donut-sync/src/config.rs 的 Config::from_env()，
# 校验逻辑在 donut-sync/src/lib.rs 的 validate_env()。

# ── 认证 ──────────────────────────────────────────────────────────────────────
# 共享密钥（登出状态使用）。必须 ≥24 字符，且不能是 CHANGE_ME* / secret-sync-token。
#   openssl rand -hex 32
SYNC_TOKEN=

# 允许“已登录的 Donut 账号”把设备指到这台服务器时填它，必须与 App 里输入的地址逐字一致。
# 留空则只有 SYNC_TOKEN 模式（纯自建、不依赖 Donut 账号）。
# 服务器需能访问 https://api.donutbrowser.com 校验登录令牌。
SYNC_PUBLIC_URL=

# ── 对外地址（反向代理）──────────────────────────────────────────────────────
# 同步 API 的域名，与 SYNC_PUBLIC_URL 的主机名保持一致
SYNC_HOST=sync.example.com
# 对象存储的域名：预签名 URL 直连这里，必须能被每台设备解析并访问
S3_HOST=s3.example.com
# Let's Encrypt 联系邮箱（内网自签可留空，并在 Caddyfile 里启用 tls internal）
ACME_EMAIL=

# ── S3 / S3 兼容存储 ─────────────────────────────────────────────────────────
# preset：compose 内置的 rclone serve s3 用这组凭据；换成 R2/B2/AWS 时改这里。
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=donut-sync
S3_REGION=us-east-1
# 默认就是 true（lib.rs:127 只有显式 "false" 才会关闭路径风格）
S3_FORCE_PATH_STYLE=true

# 预签名 URL 的签名主机（lib.rs:162-191）。留空会退化成 S3_ENDPOINT，
# 那在 compose 里是 http://s3:9000 —— 客户端打不开，而健康检查依旧绿。
S3_PUBLIC_ENDPOINT=https://s3.example.com

# ── 服务端静态加密（可选，与客户端 E2E 独立的第二层）────────────────────────
# 格式 id:base64(32 字节)，首个加密其余解密，可平滑轮换：
#   openssl rand -base64 32   →   SYNC_AT_REST_KEY=k1:<该值>
# 留空 = 不加密（此时安全性完全依赖客户端 E2E）。
SYNC_AT_REST_KEY=

# ── 其它 ─────────────────────────────────────────────────────────────────────
# 宿主机只回环暴露的健康检查端口
SYNC_LOCAL_PORT=12342
TZ=UTC

# 想改用 Derp 时钉住镜像版本
# DONUT_SYNC_IMAGE=donutbrowser/donut-sync:latest
